# Copy this file to `.env` and fill in the authorization server.
# Values already present in the environment win over this file.

# Base URL of Keycloak, without a trailing slash.
# Authorization, token, logout and keys are derived from this address and the realm.
KEYCLOAK_URL=https://keycloak.example.com

KEYCLOAK_REALM=silhouette
KEYCLOAK_CLIENT_ID=silhouette

# Required only for a confidential client. Leave unset for a public client with PKCE.
# KEYCLOAK_CLIENT_SECRET=

# Optional. Defaults to {KEYCLOAK_URL}/realms/{KEYCLOAK_REALM}.
# Set this when the issuer in the token differs from that address.
# KEYCLOAK_ISSUER=

# Optional. Defaults to {origin of the incoming request}/api/callback.
# Must match a Valid Redirect URI of the Keycloak client exactly.
# KEYCLOAK_REDIRECT_URI=http://localhost:4200/api/callback
